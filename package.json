{
  "name": "indieweb",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend/blog",
    "frontend/photos"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npm run start --workspaces",
    "build": "npm run build --workspaces",
    "build:blog": "npm run build -w frontend/blog",
    "build:photos": "npm run build -w frontend/photos",
    "start:blog": "npm run start -w frontend/blog",
    "start:photos": "npm run start -w frontend/photos",
    "dev": "npm run start",
    "clean": "rm -rf frontend/blog/_site frontend/photos/_site node_modules",
    "lint": "npm run lint:js && npm run lint:go",
    "lint:js": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:go": "cd backend && golangci-lint run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
